    "# 分析LTP/LTD演化过程\nfig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "# LTP演化过程（基于实验数据）\ntime_ltp = np.linspace(0, 200, 100)\nmemristor_model = ExperimentalMemristor()\n\n# LRS到HRS的导电率范围\nlrs = 1e-3\nhrs = 1e-9\n\n# LTP过程：导电率增加\ngs_ltp = [memristor_model.ltp_evolution(t) for t in time_ltp]\ncurrents_ltp = [memristor_model.conductance_to_current(g) * 1e6 for g in gs_ltp]  # 转换为µA\n\naxes[0].plot(time_ltp, currents_ltp, 'b-', linewidth=2.5, label='LTP (UV激励)')\naxes[0].fill_between(time_ltp, currents_ltp, alpha=0.3)\naxes[0].set_xlabel('时间 (秒)')\naxes[0].set_ylabel('电流 (µA)')\naxes[0].set_title('LTP过程：长期增强 (0-200s)')\naxes[0].set_yscale('log')\naxes[0].grid(alpha=0.3)\naxes[0].legend()\n\n# LTD演化过程（基于实验数据）\ntime_ltd = np.linspace(0, 400, 100)\n\n# LTD过程：导电率减少\ngs_ltd = [memristor_model.ltd_evolution(t) for t in time_ltd]\ncurrents_ltd = [memristor_model.conductance_to_current(g) * 1e6 for g in gs_ltd]\n\naxes[1].plot(time_ltd, currents_ltd, 'r-', linewidth=2.5, label='LTD (电晕放电)')\naxes[1].fill_between(time_ltd, currents_ltd, alpha=0.3, color='red')\naxes[1].set_xlabel('时间 (秒)')\naxes[1].set_ylabel('电流 (µA)')\naxes[1].set_title('LTD过程：长期抑制 (0-400s)')\naxes[1].set_yscale('log')\naxes[1].grid(alpha=0.3)\naxes[1].legend()\n\nplt.tight_layout()\nplt.savefig('ltp_ltd_characteristics.png', dpi=300, bbox_inches='tight')\nplt.show()\n\nprint(\"✓ LTP/LTD特性曲线已保存为 'ltp_ltd_characteristics.png'\")"
