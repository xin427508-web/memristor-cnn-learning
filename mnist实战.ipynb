    "axes[0, 1].set_xlabel('Epoch')\n",
    "axes[0, 1].set_ylabel('损失值')\n",
    "axes[0, 1].set_title('测试损失对比')\n",
    "axes[0, 1].legend()\n",
    "axes[0, 1].grid(alpha=0.3)\n",
    "\n",
    "# 训练准确率对比\n",
    "axes[1, 0].plot(history_memristor['train_acc'], marker='o', label='忆阻器模型', linewidth=2)\n",
    "axes[1, 0].plot(history_standard['train_acc'], marker='s', label='标准CNN', linewidth=2)\n",
    "axes[1, 0].set_xlabel('Epoch')\n",
    "axes[1, 0].set_ylabel('准确率 (%)')\n",
