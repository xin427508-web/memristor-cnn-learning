{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 基于忆阻器LTP/LTD的CNN训练与测试\n",
    "## 使用实验测得的忆阻器特性数据\n",
    "- LTP: UV激励阶段 (0-200s)，电流从0.1µA上升到1µA\n",
    "- LTD: 电晕放电阶段 (200-600s)，电流从1µA下降到0.1µA\n",
    "- 导电率范围：HRS (10⁻⁹) 到 LRS (10⁻³)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.optim as optim\n",
    "import torch.nn.functional as F\n",
    "from torchvision import datasets, transforms\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "from tqdm import tqdm\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# 设置中文字体\n",
    "plt.rcParams['font.sans-serif'] = ['SimHei']\n",
    "plt.rcParams['axes.unicode_minus'] = False\n",
    "\n",
    "%matplotlib inline"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 导入忆阻器模型"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 引入忆阻器模型\n",
    "from memristor_experimental import (\n",
    "    ExperimentalMemristor,\n",
    "    MemristorLinearExperimental,\n",
    "    MemristorCNNExperimental\n",
    ")\n",
    "\n",
    "print(\"✓ 忆阻器模型加载成功\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. 数据准备"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 数据集参数\n",
    "BATCH_SIZE = 64\n",
    "INPUT_SIZE = 28\n",
    "NUM_CLASSES = 10\n",
    "NUM_EPOCHS = 5\n",
    "LEARNING_RATE = 0.001\n",
    "\n",
    "# 数据预处理\n",
    "transform = transforms.Compose([\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize((0.1307,), (0.3081,))  # MNIST标准化参数\n",
    "])\n",
    "\n",
    "# 加载MNIST数据集\n",
    "print(\"加载MNIST数据集...\")\n",
    "train_dataset = datasets.MNIST(root='./data', train=True, \n",
    "                               transform=transform, download=True)\n",
    "test_dataset = datasets.MNIST(root='./data', train=False, \n",
    "                              transform=transform, download=True)\n",
    "\n",
    "train_loader = torch.utils.data.DataLoader(dataset=train_dataset,\n",
    "                                           batch_size=BATCH_SIZE,\n",
    "                                           shuffle=True)\n",
    "test_loader = torch.utils.data.DataLoader(dataset=test_dataset,\n",
    "                                          batch_size=BATCH_SIZE,\n",
    "                                          shuffle=False)\n",
    "\n",
    "print(f\"✓ 训练集大小: {len(train_dataset)}\")\n",
    "print(f\"✓ 测试集大小: {len(test_dataset)}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. 构建CNN模型（集成忆阻器学习）"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class MemristorCNN(nn.Module):\n",
    "    \"\"\"集成忆阻器LTP/LTD学习的CNN模型\"\"\"\n",
    "    \n",
    "    def __init__(self, use_memristor=True):\n",
    "        super(MemristorCNN, self).__init__()\n",
    "        self.use_memristor = use_memristor\n",
    "        \n",
    "        # 卷积层序列1\n",
    "        if use_memristor:\n",
    "            self.conv1 = MemristorCNNExperimental(\n",
    "                in_channels=1, out_channels=16, kernel_size=5,\n",
    "                stride=1, padding=2, use_memristor=True\n",
    "            )\n        else:\n",
    "            self.conv1 = nn.Conv2d(1, 16, kernel_size=5, stride=1, padding=2)\n",
    "        \n",
    "        self.relu1 = nn.ReLU()\n",
    "        self.pool1 = nn.MaxPool2d(kernel_size=2)\n",
    "        \n",
    "        # 卷积层序列2\n",
    "        if use_memristor:\n",
    "            self.conv2 = MemristorCNNExperimental(\n",
    "                in_channels=16, out_channels=32, kernel_size=5,\n",
    "                stride=1, padding=2, use_memristor=True\n",
    "            )\n",
    "        else:\n",
    "            self.conv2 = nn.Conv2d(16, 32, kernel_size=5, stride=1, padding=2)\n",
    "        \n",
    "        self.relu2 = nn.ReLU()\n",
    "        self.pool2 = nn.MaxPool2d(kernel_size=2)\n",
    "        \n",
    "        # 卷积层序列3\n",
    "        if use_memristor:\n",
    "            self.conv3 = MemristorCNNExperimental(\n",
    "                in_channels=32, out_channels=64, kernel_size=5,\n",
    "                stride=1, padding=2, use_memristor=True\n",
    "            )\n",
    "        else:\n",
    "            self.conv3 = nn.Conv2d(32, 64, kernel_size=5, stride=1, padding=2)\n",
    "        \n",
    "        self.relu3 = nn.ReLU()\n",
    "        \n",
    "        # 全连接层\n",
    "        if use_memristor:\n",
    "            self.fc = MemristorLinearExperimental(\n",
    "                in_features=64*7*7, out_features=10, use_memristor=True\n",
    "            )\n",
    "        else:\n",
    "            self.fc = nn.Linear(64*7*7, 10)\n",
    "    \n",
    "    def forward(self, x):\n",
    "        # Conv1 + ReLU + Pool: (1,28,28) -> (16,14,14)\n",
    "        x = self.conv1(x)\n",
    "        x = self.relu1(x)\n",
    "        x = self.pool1(x)\n",
    "        \n",
    "        # Conv2 + ReLU + Pool: (16,14,14) -> (32,7,7)\n",
    "        x = self.conv2(x)\n",
    "        x = self.relu2(x)\n",
    "        x = self.pool2(x)\n",
    "        \n",
    "        # Conv3 + ReLU: (32,7,7) -> (64,7,7)\n",
    "        x = self.conv3(x)\n",
    "        x = self.relu3(x)\n",
    "        \n",
    "        # Flatten\n",
    "        x = x.view(x.size(0), -1)\n",
    "        \n",
    "        # FC\n",
    "        x = self.fc(x)\n",
    "        \n",
    "        return x\n",
    "    \n",
    "    def memristor_update(self):\n",
    "        \"\"\"执行忆阻器权重更新\"\"\"\n",
    "        if self.use_memristor:\n",
    "            if hasattr(self.conv1, 'memristor_update'):\n",
    "                self.conv1.memristor_update()\n",
    "            if hasattr(self.conv2, 'memristor_update'):\n",
    "                self.conv2.memristor_update()\n",
    "            if hasattr(self.conv3, 'memristor_update'):\n",
    "                self.conv3.memristor_update()\n",
    "            if hasattr(self.fc, 'memristor_update'):\n",
    "                self.fc.memristor_update()\n",
    "\n",
    "# 创建模型\n",
    "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
    "print(f\"使用设备: {device}\")\n",
    "\n",
    "# 两种模型用于对比\n",
    "model_with_memristor = MemristorCNN(use_memristor=True).to(device)\n",
    "model_standard = MemristorCNN(use_memristor=False).to(device)\n",
    "\n",
    "print(\"✓ 模型创建成功\")\n",
    "print(f\"\\n模型结构：\")\n",
    "print(model_with_memristor)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. 损失函数与优化器"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 损失函数\n",
    "criterion = nn.CrossEntropyLoss()\n",
    "\n",
    "# 优化器\n",
    "optimizer_memristor = optim.Adam(model_with_memristor.parameters(), \n",
    "                                 lr=LEARNING_RATE)\n",
    "optimizer_standard = optim.Adam(model_standard.parameters(), \n",
    "                                lr=LEARNING_RATE)\n",
    "\n",
    "# 学习率调度器\n",
    "scheduler_memristor = optim.lr_scheduler.StepLR(\n",
    "    optimizer_memristor, step_size=2, gamma=0.5\n",
    ")\n",
    "scheduler_standard = optim.lr_scheduler.StepLR(\n",
    "    optimizer_standard, step_size=2, gamma=0.5\n",
    ")\n",
    "\n",
    "print(\"✓ 优化器与损失函数初始化完成\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. 辅助函数"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def accuracy(predictions, labels):\n",
    "    \"\"\"计算准确率\"\"\"\n",
    "    pred = torch.max(predictions.data, 1)[1]\n",
    "    rights = (pred == labels.data).sum().item()\n",
    "    return rights, len(labels)\n",
    "\n",
    "def train_epoch(model, train_loader, criterion, optimizer, use_memristor=False, device='cpu'):\n",
    "    \"\"\"训练单个epoch\"\"\"\n",
    "    model.train()\n",
    "    total_loss = 0\n",
    "    total_correct = 0\n",
    "    total_samples = 0\n",
    "    \n",
    "    pbar = tqdm(train_loader, desc='Training')\n",
    "    for batch_idx, (data, target) in enumerate(pbar):\n",
    "        data, target = data.to(device), target.to(device)\n",
    "        \n",
    "        # 前向传播\n",
    "        output = model(data)\n",
    "        loss = criterion(output, target)\n",
    "        \n",
    "        # 反向传播\n",
    "        optimizer.zero_grad()\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "        \n",
    "        # 忆阻器权重更新（如果启用）\n",
    "        if use_memristor:\n",
    "            model.memristor_update()\n",
    "        \n",
    "        # 统计\n",
    "        total_loss += loss.item()\n",
    "        rights, total = accuracy(output, target)\n",
    "        total_correct += rights\n",
    "        total_samples += total\n",
    "        \n",
    "        pbar.set_postfix({\n",
    "            'loss': total_loss / (batch_idx + 1),\n",
    "            'acc': 100 * total_correct / total_samples\n",
    "        })\n",
    "    \n",
    "    return total_loss / len(train_loader), 100 * total_correct / total_samples\n",
    "\n",
    "def evaluate(model, test_loader, criterion, device='cpu'):\n",
    "    \"\"\"评估模型\"\"\"\n",
    "    model.eval()\n",
    "    total_loss = 0\n",
    "    total_correct = 0\n",
    "    total_samples = 0\n",
    "    \n",
    "    with torch.no_grad():\n",
    "        for data, target in test_loader:\n",
    "            data, target = data.to(device), target.to(device)\n",
    "            output = model(data)\n",
    "            loss = criterion(output, target)\n",
    "            \n",
    "            total_loss += loss.item()\n",
    "            rights, total = accuracy(output, target)\n",
    "            total_correct += rights\n",
    "            total_samples += total\n",
    "    \n",
    "    return total_loss / len(test_loader), 100 * total_correct / total_samples\n",
    "\n",
    "print(\"✓ 辅助函数定义完成\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. 训练过程"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 记录训练过程\n",
    "history_memristor = {\n",
    "    'train_loss': [],\n",
    "    'train_acc': [],\n",
    "    'test_loss': [],\n",
    "    'test_acc': []\n",
    "}\n",
    "\n",
    "history_standard = {\n",
    "    'train_loss': [],\n",
    "    'train_acc': [],\n",
    "    'test_loss': [],\n",
    "    'test_acc': []\n",
    "}\n",
    "\n",
    "print(\"=\"*70)\n",
    "print(\"开始训练：忆阻器模型 vs 标准CNN\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "for epoch in range(NUM_EPOCHS):\n",
    "    print(f\"\\n{'='*70}\")\n",
    "    print(f\"Epoch {epoch+1}/{NUM_EPOCHS}\")\n",
    "    print(f\"{'='*70}\")\n",
    "    \n",
    "    # 忆阻器模型训练\n",
    "    print(f\"\\n[忆阻器模型] 训练中...\")\n",
    "    train_loss_m, train_acc_m = train_epoch(\n",
    "        model_with_memristor, train_loader, criterion, \n",
    "        optimizer_memristor, use_memristor=True, device=device\n",
    "    )\n",
    "    test_loss_m, test_acc_m = evaluate(\n",
    "        model_with_memristor, test_loader, criterion, device=device\n",
    "    )\n",
    "    \n",
    "    history_memristor['train_loss'].append(train_loss_m)\n",
    "    history_memristor['train_acc'].append(train_acc_m)\n",
    "    history_memristor['test_loss'].append(test_loss_m)\n",
    "    history_memristor['test_acc'].append(test_acc_m)\n",
    "    \n",
    "    print(f\"[忆阻器模型] 训练损失: {train_loss_m:.4f}, 训练准确率: {train_acc_m:.2f}%\")\n",
    "    print(f\"[忆阻器模型] 测试损失: {test_loss_m:.4f}, 测试准确率: {test_acc_m:.2f}%\")\n",
    "    \n",
    "    # 标准模型训练\n",
    "    print(f\"\\n[标准CNN模型] 训练中...\")\n",
    "    train_loss_s, train_acc_s = train_epoch(\n",
    "        model_standard, train_loader, criterion,\n",
    "        optimizer_standard, use_memristor=False, device=device\n",
    "    )\n",
    "    test_loss_s, test_acc_s = evaluate(\n",
    "        model_standard, test_loader, criterion, device=device\n",
    "    )\n",
    "    \n",
    "    history_standard['train_loss'].append(train_loss_s)\n",
    "    history_standard['train_acc'].append(train_acc_s)\n",
    "    history_standard['test_loss'].append(test_loss_s)\n",
    "    history_standard['test_acc'].append(test_acc_s)\n",
    "    \n",
    "    print(f\"[标准CNN模型] 训练损失: {train_loss_s:.4f}, 训练准确率: {train_acc_s:.2f}%\")\n",
    "    print(f\"[标准CNN模型] 测试损失: {test_loss_s:.4f}, 测试准确率: {test_acc_s:.2f}%\")\n",
    "    \n",
    "    # 学习率调度\n",
    "    scheduler_memristor.step()\n",
    "    scheduler_standard.step()\n",
    "    \n",
    "    # 性能对比\n",
    "    print(f\"\\n性能对比:\")\n",
    "    print(f\"  测试准确率差异: {test_acc_m - test_acc_s:+.2f}%\")\n",
    "    print(f\"  训练准确率差异: {train_acc_m - train_acc_s:+.2f}%\")\n\nprint(\"\\n\" + \"=\"*70)\nprint(\"训练完成！\")\nprint(\"=\"*70)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. 测试与评估"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def final_test(model, test_loader, device='cpu'):\n",
    "    \"\"\"最终测试\"\"\"\n",
    "    model.eval()\n",
    "    total_correct = 0\n",
    "    total_samples = 0\n",
    "    predictions = []\n",
    "    ground_truths = []\n",
    "    \n",
    "    with torch.no_grad():\n",
    "        for data, target in tqdm(test_loader, desc='Final Test'):\n",
    "            data, target = data.to(device), target.to(device)\n",
    "            output = model(data)\n",
    "            \n",
    "            pred = torch.argmax(output, dim=1)\n",
    "            total_correct += (pred == target).sum().item()\n",
    "            total_samples += target.size(0)\n",
    "            \n",
    "            predictions.extend(pred.cpu().numpy())\n",
    "            ground_truths.extend(target.cpu().numpy())\n",
    "    \n",
    "    accuracy = 100 * total_correct / total_samples\n",
    "    return accuracy, predictions, ground_truths\n",
    "\n",
    "# 最终测试\n",
    "print(\"\\n\" + \"=\"*70)\n",
    "print(\"最终测试评估\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "print(\"\\n[忆阻器模型] 最终测试中...\")\nacc_memristor, pred_m, gt_m = final_test(model_with_memristor, test_loader, device=device)\n\nprint(\"\\n[标准CNN模型] 最终测试中...\")\nacc_standard, pred_s, gt_s = final_test(model_standard, test_loader, device=device)\n\nprint(\"\\n\" + \"=\"*70)\nprint(\"最终测试结果\")\nprint(\"=\"*70)\nprint(f\"\\n忆阻器模型:\")\nprint(f\"  总样本数: {len(test_dataset)}\")\nprint(f\"  正确分类: {int(acc_memristor * len(test_dataset) / 100)}\")\nprint(f\"  测试准确率: {acc_memristor:.2f}%\")\n\nprint(f\"\\n标准CNN模型:\")\nprint(f\"  总样本数: {len(test_dataset)}\")\nprint(f\"  正确分类: {int(acc_standard * len(test_dataset) / 100)}\")\nprint(f\"  测试准确率: {acc_standard:.2f}%\")\n\nprint(f\"\\n性能提升:\")\nprint(f\"  准确率差异: {acc_memristor - acc_standard:+.2f}%\")\nprint(f\"  相对提升: {(acc_memristor - acc_standard) / acc_standard * 100:+.2f}%\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. 可视化结果"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 创建对比图\n",
    "fig, axes = plt.subplots(2, 2, figsize=(14, 10))\n",
    "\n",
    "# 训练损失对比\n",
    "axes[0, 0].plot(history_memristor['train_loss'], marker='o', label='忆阻器模型', linewidth=2)\n",
