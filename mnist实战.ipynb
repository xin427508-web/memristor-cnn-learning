    "axes[1, 0].legend()\n",
    "axes[1, 0].grid(alpha=0.3)\n",
    "\n",
    "# 测试准确率对比\n",
    "axes[1, 1].plot(history_memristor['test_acc'], marker='o', label='忆阻器模型', linewidth=2)\n",
    "axes[1, 1].plot(history_standard['test_acc'], marker='s', label='标准CNN', linewidth=2)\n",
    "axes[1, 1].set_xlabel('Epoch')\n",
    "axes[1, 1].set_ylabel('准确率 (%)')\n",
    "axes[1, 1].set_title('测试准确率对比')\n",
    "axes[1, 1].legend()\n",
    "axes[1, 1].grid(alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('training_comparison.png', dpi=300, bbox_inches='tight')\n",
